# control-api environment contract. Set these as Railway service variables.
# Copy to .env for local runs. NEVER commit a filled-in copy.

# --- Control plane ---------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/railway
# Shared secret for ALL internal service-to-service HTTP (ingress, tenants, CLIs).
INTERNAL_API_TOKEN=change-me
# Public base URL of this service.
CONTROL_API_URL=https://control-api-production-588b.up.railway.app
# What TENANTS are handed as CONTROL_API_URL. Use the Railway private-network
# address: every tenant heartbeats every 5 minutes, and that traffic should not
# cross the public internet (or be billed as egress on both ends) to reach a
# service sitting one hop away. Falls back to CONTROL_API_URL when empty.
# The hostname is derived from the control-api SERVICE NAME in the Railway project.
CONTROL_API_INTERNAL_URL=http://control-api.railway.internal:8080

# --- Railway (provisioning) ------------------------------------------------
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_GRAPHQL_URL=https://backboard.railway.com/graphql/v2
# Scale-to-zero for tenant services -- half of the unit-economics bet (Gate G1).
RAILWAY_TENANT_SLEEP=true

# --- Tenant runtime --------------------------------------------------------
# ALWAYS an explicit tag, never :latest -- /fleet and the upgrade drill both work
# by comparing image references, and a floating tag makes the fleet unreadable.
# Published by pushing a `tenant-image-v<version>` git tag; the tag must exist on
# GHCR before the first provision.
TENANT_IMAGE=ghcr.io/shagarwal/squire/hermes-tenant:v0.1.0
# CROSS-SERVICE CONSTANT: must equal the tenant image's volume (ENV HOME /
# HERMES_HOME / SQUIRE_VOLUME = /opt/data). A mismatch does not degrade anything;
# the tenant's durability gate refuses to boot at all, because pg0 would put the
# memory database on ephemeral storage. Pinned by a test that reads the Dockerfile.
TENANT_VOLUME_MOUNT_PATH=/opt/data
TENANT_PORT=8080

# --- Ingress ---------------------------------------------------------------
# Telegram webhooks are registered as <INGRESS_PUBLIC_URL>/telegram/<bot_id>.
# The same URL is also handed to the tenant as TELEGRAM_WEBHOOK_URL (see below).
INGRESS_PUBLIC_URL=https://ingress-production-6c96.up.railway.app

# --- Trial proxy (LiteLLM) -------------------------------------------------
# Leave LITELLM_BASE_URL empty to provision without trial keys (Task 0.5 pending).
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
TRIAL_MAX_BUDGET_USD=2.0
TRIAL_DURATION=72h

# --- Variables control-api SETS on each tenant service ----------------------
# Not read from here -- listed so the contract with the tenant image (Task 0.2)
# is written down in one place. All are set by _step_set_variables at provision:
#   TENANT_ID                 tenant's short id
#   TELEGRAM_BOT_TOKEN        assigned pool bot's BotFather token
#   TELEGRAM_WEBHOOK_URL      {INGRESS_PUBLIC_URL}/telegram/{bot_id} -- byte-for-byte
#                             what control-api registers with Telegram, so the tenant
#                             image's own boot-time setWebhook is a harmless re-register
#   TELEGRAM_WEBHOOK_SECRET   per-bot secret_token, same value ingress verifies
#   SQUIRE_DEK                32 random bytes b64; generated here, NEVER stored in control-db
#   ANTHROPIC_BASE_URL        trial proxy base URL
#   ANTHROPIC_API_KEY         per-tenant LiteLLM virtual key ($2 hard budget)
#   CONTROL_API_URL           this service, for tenant -> control-api callbacks
#   INTERNAL_API_TOKEN        shared internal bearer token
#   PORT                      8080
#   SQUIRE_IMAGE_REF          the image the container is running; echoed back on
#                             every heartbeat so /fleet can report what the fleet
#                             actually runs and the upgrade drill can prove a
#                             canary converged. Overwritten by
#                             POST /internal/tenants/{id}/redeploy.

# --- Fleet heartbeat (Task 0.6) --------------------------------------------
# Tenants beat every 300s (SQUIRE_HEARTBEAT_INTERVAL, baked into the image), so
# 900 is three missed beats before GET /internal/fleet calls a tenant stale.
HEARTBEAT_STALE_SECONDS=900

# --- Provisioning state machine --------------------------------------------
PROVISION_MAX_ATTEMPTS=5
PROVISION_BACKOFF_BASE_SECONDS=5
PROVISION_AUTO_ADVANCE=true
PROVISION_WORKER_ENABLED=true
PROVISION_WORKER_INTERVAL_SECONDS=10
