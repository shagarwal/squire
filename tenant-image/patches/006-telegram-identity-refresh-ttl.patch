-                self._bot_identity_refresh_task = asyncio.ensure_future(
-                    self._bot_identity_refresh_loop()
-                )
+                # (squire patch 006) A TTL <= 0 means the refresh loop is never
+                # started. The loop's get_me() every TTL seconds is permanent
+                # outbound HTTPS traffic; on a serverless platform that sleeps
+                # only after a quiet window (Railway: ~10 min) it keeps every
+                # webhook-mode tenant awake 24/7. Squire controls its pool
+                # bots' usernames, so the BotFather-rename detection the loop
+                # exists for buys nothing there. Inbound-triggered rechecks
+                # (_schedule_bot_identity_recheck) still work when disabled:
+                # they only fire while handling a message, i.e. while the
+                # container is awake anyway.
+                if self._BOT_IDENTITY_TTL_SECONDS > 0:
+                    self._bot_identity_refresh_task = asyncio.ensure_future(
+                        self._bot_identity_refresh_loop()
+                    )
+                else:
+                    logger.info(
+                        "[%s] Telegram identity refresh disabled "
+                        "(SQUIRE_TELEGRAM_IDENTITY_TTL <= 0); a BotFather "
+                        "rename will not be noticed until restart",
+                        self.name,
+                    )
 
