+        # (squire patch 005) Squire ships its own first-conversation flow (the
+        # `concierge` skill, driven deterministically by the pre_llm_call hook
+        # in bin/squire-concierge-hook.py). Upstream's first-contact note is a
+        # COMPETING directive in the exact same user-message sidecar slot: it
+        # tells the model to keep the introduction to "one or two sentences max"
+        # and to advertise /help. On a Haiku-class trial model that short,
+        # concrete instruction reliably beats our longer one, which is precisely
+        # how the first live tenant produced a two-line greeting and no
+        # onboarding at all. So: while Squire's concierge is mid-flow, upstream's
+        # note is suppressed and the concierge owns the turn. Once concierge
+        # state reads `complete` (or the file is absent/corrupt, i.e. this is not
+        # a Squire tenant) upstream's behaviour is restored untouched.
+        _squire_concierge_active = False
+        try:
+            import json as _sq_json
+            _sq_state_path = _hermes_home / ".squire" / "concierge-state.json"
+            _sq_raw = _sq_json.loads(_sq_state_path.read_text(encoding="utf-8"))
+            _squire_concierge_active = (
+                isinstance(_sq_raw, dict)
+                and str(_sq_raw.get("state") or "").strip() != "complete"
+            )
+        except Exception:
+            # Missing file, bad JSON, unreadable path -> not a Squire tenant
+            # mid-onboarding. Fail OPEN to upstream behaviour; never let this
+            # check break the first message.
+            _squire_concierge_active = False
+
         # First-message onboarding -- only on the very first interaction ever.
