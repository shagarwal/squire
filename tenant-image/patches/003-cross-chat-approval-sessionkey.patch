@@ -3621,6 +3621,15 @@ class GatewaySlashCommandsMixin:
         """
         source = event.source
         session_key = self._session_key_for_source(source)
+        # (custom patch 003) Cross-chat approval: when an explicit session key
+        # (a token containing ':' that isn't a modifier) is passed, target THAT
+        # session instead of the chat we replied from -- enables `/approve <key>`
+        # and `/deny <key>` from the monitor/home chat. Plain /approve is unchanged.
+        _xchat_args = event.get_command_args().strip().split()
+        _xchat_modifiers = {"all", "session", "always", "permanent", "permanently"}
+        _xchat_key = next((a for a in _xchat_args if ":" in a and a.lower() not in _xchat_modifiers), None)
+        if _xchat_key:
+            session_key = _xchat_key
 
